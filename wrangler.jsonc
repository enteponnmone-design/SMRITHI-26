{
  "name": "smrithi-26",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smrithi-db",
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE"
    }
  ]
}
